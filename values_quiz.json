{
  "title": "Life Compass — Values Quiz",
  "version": 1,
  "valueLibrary": "life_compass_intrinsic_values.json",
  "description": "A short, reflective values-discovery exercise. Answer five questions; repeated value signals suggest values to explore, not an objective personality result.",
  "settings": {
    "questionsPerSession": 5,
    "selectionType": "single",
    "allowRetake": true,
    "maxSuggestedValues": 6
  },
  "scoring": {
    "method": "weighted_value_overlap",
    "rules": [
      "Each selected answer adds 1 point to each valueId in that answer.",
      "Track how many different answered questions supported each valueId; this is the overlap count.",
      "Rank by overlap count first, then total points, then the original order in the values library for deterministic ties.",
      "Use valueIds to look up value names and descriptions; do not invent new IDs.",
      "Results are tentative suggestions; let the user accept, replace, or reject up to six values."
    ],
    "categorySelection": "Category relevance is the sum of scores of values in the category, used ONLY to select follow-up questions, never as a value score.",
    "tieHandling": "Return all tied candidates in ranked order up to maxSuggestedValues; do not claim ties are precise distinctions."
  },
  "questionSelection": {
    "mode": "adaptive_five_question",
    "steps": [
      {
        "number": 1,
        "pool": "explore",
        "rule": "Choose one exploratory question, rotating between sessions."
      },
      {
        "number": 2,
        "pool": "explore",
        "rule": "Choose a different exploratory question. Prefer one whose options cover categories not favored by the first answer."
      },
      {
        "number": 3,
        "pool": "focus",
        "rule": "Ask the first focused question from the highest-scoring category represented by answers so far."
      },
      {
        "number": 4,
        "pool": "focus",
        "rule": "Ask the first focused question from the second-highest-scoring category, if distinct; otherwise ask an unused broad question."
      },
      {
        "number": 5,
        "pool": "focus",
        "rule": "Ask the other focused question for the leading category, preferably where a value already received a signal; never repeat a question."
      }
    ],
    "fallback": "If scores are tied or categories are unrepresented, choose deterministically with the current session seed, ensuring five distinct questions.",
    "biasNotice": "Five answers cannot reliably distinguish all 120 values. Avoid presenting results as a validated psychological assessment."
  },
